{
  "name": "word-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild .smoke-entry.tsx --bundle --format=esm --platform=node --splitting --outdir=.smoke-dist --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime --external:zustand && node smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
